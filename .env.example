# Copy to .env and fill in. Anything left blank uses the default in config.js.

# --- Business details (placeholders shown on the site) ---
BUSINESS_NAME=
PHONE=
PHONE_HREF=
EMAIL=
ADDRESS_LINE=
HOURS=

# --- Server ---
PORT=3000
ADMIN_PASSWORD=change-me
# Your public web address (used for the social-share image), e.g. https://www.jfhauling.ca
SITE_URL=

# --- Optional: AI (any OpenAI-compatible API). Leave blank = guided assistant, no AI needed ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Where quote and contact JSON files are stored. Created if missing.
# On Render this is the persistent disk mount.
DATA_DIR=

# --- Dispatch alerts ---
# Resend (HTTPS) is used when RESEND_API_KEY is set. SMTP is used only when that key is blank.
# Verify the from-address domain in Resend before going live.
RESEND_API_KEY=
MAIL_FROM="JF Hauling Website <quotes@jfhauling.ca>"
# Who receives quote and contact alerts. Blank uses the owner address in config.js.
NOTIFY_TO=

# --- Fallback SMTP (ignored while RESEND_API_KEY is set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Google reviews (Places API New). The key stays on the server. Blank = manualReviews in config.js ---
GOOGLE_PLACES_API_KEY=
# How long to keep reviews in memory, in hours (1–12). They are not written to disk.
GOOGLE_REVIEWS_CACHE_HOURS=6

# --- Optional: distance lookup (OpenStreetMap). Set false to always ask customers for km ---
ROUTING_ENABLED=true
GEOCODER_USER_AGENT=TruckingQuoteAssistant/1.0 (contact: you@example.com)
